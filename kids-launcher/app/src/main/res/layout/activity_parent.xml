<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="家长设置"
            android:textColor="@color/ink"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/home_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/guard_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/usage_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="保护密码"
            android:textColor="@color/ink"
            android:textSize="18sp" />

        <Button
            android:id="@+id/change_password_button"
            style="@style/Widget.Kids.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="修改保护密码" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="应用白名单"
            android:textColor="@color/ink"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/whitelist_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />

        <Button
            android:id="@+id/whitelist_button"
            style="@style/Widget.Kids.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="修改白名单" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="切换到其他桌面"
            android:textColor="@color/ink"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="切换前会再确认一次。系统桌面列表打开后，请把默认桌面改成别的。"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />

        <Button
            android:id="@+id/switch_button"
            style="@style/Widget.Kids.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="切换系统桌面" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="防逃离"
            android:textColor="@color/ink"
            android:textSize="18sp" />

        <Button
            android:id="@+id/accessibility_button"
            style="@style/Widget.Kids.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="打开无障碍设置" />

        <Button
            android:id="@+id/usage_button"
            style="@style/Widget.Kids.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="允许查看使用情况" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="设备所有者锁定"
            android:textColor="@color/ink"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/owner_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/adb_command"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textColor="@color/ink"
            android:textIsSelectable="true"
            android:textSize="13sp" />

        <Button
            android:id="@+id/relock_button"
            style="@style/Widget.Kids.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="重新锁定"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="忘记密码"
            android:textColor="@color/ink"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/recovery"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />

        <Button
            android:id="@+id/done_button"
            style="@style/Widget.Kids.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="返回儿童桌面" />
    </LinearLayout>
</ScrollView>
